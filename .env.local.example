# Server-side keys (never exposed to the browser). Set at least one, or let users paste their own key in the UI.
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
# Optional CNN layout service (docker compose provides this automatically)
CNN_SERVICE_URL=
