# ───────── LLM providers (both are free tier, no credit card) ─────────
# Groq  → https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini → https://aistudio.google.com/apikey
# (legacy name GOOGLE_API_KEY from v1 is also accepted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# You can set just one key. With both, each agent uses its preferred provider and
# automatically falls back to the other one on error / rate limit.
# With neither key the app still runs in OFFLINE mode (rule-based analysis + RAG chat).

# ───────── CNN layout service (optional) ─────────
# Local:  http://localhost:8000      Docker compose: http://cnn:8000
CNN_SERVICE_URL=

# ───────── Limits (defaults shown) ─────────
MAX_FILE_MB=4
MAX_RESUME_CHARS=12000
MAX_JD_CHARS=6000
ANALYZE_LIMIT_PER_10MIN=6
CHAT_LIMIT_PER_10MIN=40

# ───────── GitHub Pages / split deployment ─────────
# Origins allowed to call this API from a browser (the static Pages site). Comma separated, no trailing slash.
ALLOWED_ORIGINS=https://nikhil-creat.github.io,http://localhost:3000
# Build-time only (set in the Pages workflow, not here): NEXT_PUBLIC_API_BASE=https://your-backend.vercel.app
